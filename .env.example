# ============================================
# HARI MARG — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your secrets.
# NEVER commit .env to Git!
# ============================================

# Secret key for Flask session cookie signing (REQUIRED in Production)
SESSION_SECRET_KEY=

# Admin panel password (REQUIRED in Production)
ADMIN_PASSWORD=

# Supabase PostgreSQL connection string (REQUIRED for production DB)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# Supabase API URL and Secret Key (REQUIRED for storage CDN & DB access)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=hari-marg-photos

# Optional: Secret passcode for instant volunteer approval
VOLUNTEER_SECRET_CODE=

# AI Chatbot API key (Groq LLM)
GROQ_API_KEY=

# Weather API key (OpenWeatherMap)
OPENWEATHER_API_KEY=
